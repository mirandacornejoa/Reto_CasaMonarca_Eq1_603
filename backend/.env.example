# ───────────────────────────────────────────────────────────────────
# Casa Monarca — Gestor de Identidades
# Configuración de entorno (.env)
# ───────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────
APP_NAME=Casa Monarca Identity Manager
API_V1_PREFIX=/api/v1

# ── Seguridad ──────────────────────────────────────────────────────
# Genera una clave aleatoria segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Base de datos ──────────────────────────────────────────────────
# SQLite (por defecto para desarrollo local):
SQLITE_PATH=./app.db
AUTO_CREATE_TABLES=true

# MySQL (producción): descomentar y configurar
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DB=casa_monarca

# ── SMTP (correo electrónico) ─────────────────────────────────────
# Si no se configuran, el sistema opera en MODO DEMO:
# los enlaces de activación y códigos OTP se muestran en consola
# y están disponibles vía GET /auth/demo/activation-links
#
# Gmail (requiere App Password, no tu contraseña normal):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASSWORD=tu-app-password-de-16-chars
#   SMTP_FROM_EMAIL=tu-correo@gmail.com
#   SMTP_USE_TLS=true
#
# Mailgun:
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USER=postmaster@tu-dominio.mailgun.org
#   SMTP_PASSWORD=tu-api-key
#   SMTP_FROM_EMAIL=no-reply@tu-dominio.org
#   SMTP_USE_TLS=true
#
# Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=tu-correo@outlook.com
#   SMTP_PASSWORD=tu-contraseña
#   SMTP_FROM_EMAIL=tu-correo@outlook.com
#   SMTP_USE_TLS=true
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@demo.org
SMTP_USE_TLS=true

# ── Activación de cuenta ──────────────────────────────────────────
ACTIVATION_TOKEN_EXPIRE_HOURS=48
ACTIVATION_URL_BASE=http://localhost:5173/activate

# ── Two-Factor Authentication (2FA) ──────────────────────────────
OTP_EXPIRE_MINUTES=10
PRE2FA_TOKEN_EXPIRE_MINUTES=10
TOTP_ENROLL_TOKEN_EXPIRE_MINUTES=10

# ── Cifrado de campos sensibles ───────────────────────────────────
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OBLIGATORIO en producción. Sin esta clave, contact_info y name_or_alias_enc no se cifran.
FIELD_ENCRYPTION_KEY=

# ── Cuenta admin por defecto (solo para seed) ─────────────────────
ADMIN_EMAIL=admin@demo.org
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador del Sistema

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
