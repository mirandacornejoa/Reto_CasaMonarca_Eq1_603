# Root reference env file.
# Copy values into backend/.env and frontend/.env as needed.

# -------------------------
# Backend (FastAPI)
# -------------------------
APP_NAME=Identity Access Demo
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DB=identity_demo
SQLITE_PATH=./app.db

AUTO_CREATE_TABLES=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@demo.org
SMTP_USE_TLS=true

ACTIVATION_TOKEN_EXPIRE_HOURS=48
ACTIVATION_URL_BASE=http://localhost:5173/activate

ADMIN_EMAIL=admin@demo.org
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador del Sistema

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------
# Frontend (Vite)
# -------------------------
VITE_API_URL=http://localhost:8000/api/v1
